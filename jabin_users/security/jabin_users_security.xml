<?xml version="1.0" encoding="utf-8"?>
<!--
  JABIN Users – Access Rights (Sprint 2)

  This file declares:
    1. A security group: JABIN > User Manager (administrators who can manage
       all user accounts).
    2. Access rights (ir.model.access) for the models introduced by this
       module:
         - jabin.user.address (full CRUD for managers; read for others)
         - jabin.user.service (no DB access – it is an AbstractModel used as
           a service locator; we still declare access so Odoo does not warn).

  Notes
  ~~~~~
  * The extended res.users fields are governed by Odoo's native access rights
    on res.users; we do not need to re-declare access for res.users here.
  * Service AbstractModels have no table; Odoo requires an access record
    (with all perms set to 0) to avoid a warning at install time.
-->
<odoo>
    <data>

        <!-- ============================================================== -->
        <!-- Security group: JABIN User Manager                            -->
        <!-- ============================================================== -->
        <record id="jabin_user_manager_group" model="res.groups">
            <field name="name">JABIN User Manager</field>
            <field name="category_id" ref="base.module_category_services_jabin"/>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="comment">Can manage all JABIN user accounts and addresses.</field>
        </record>

        <!-- ============================================================== -->
        <!-- Access rights: jabin.user.address                              -->
        <!-- ============================================================== -->
        <record id="jabin_user_address_access_manager" model="ir.model.access">
            <field name="name">jabin.user.address: manager full access</field>
            <field name="model_id" ref="model_jabin_user_address"/>
            <field name="group_id" ref="jabin_user_manager_group"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <record id="jabin_user_address_access_user_read" model="ir.model.access">
            <field name="name">jabin.user.address: user read</field>
            <field name="model_id" ref="model_jabin_user_address"/>
            <field name="group_id" ref="base.group_user"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="0"/>
            <field name="perm_create" eval="0"/>
            <field name="perm_unlink" eval="0"/>
        </record>

        <!-- ============================================================== -->
        <!-- Access rights: jabin.user.service (AbstractModel, no table)    -->
        <!-- ============================================================== -->
        <record id="jabin_user_service_access" model="ir.model.access">
            <field name="name">jabin.user.service: no-table access</field>
            <field name="model_id" ref="model_jabin_user_service"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

        <!-- ============================================================== -->
        <!-- Access rights: jabin.address.service (AbstractModel, no table) -->
        <!-- ============================================================== -->
        <record id="jabin_address_service_access" model="ir.model.access">
            <field name="name">jabin.address.service: no-table access</field>
            <field name="model_id" ref="model_jabin_address_service"/>
            <field name="perm_read" eval="1"/>
            <field name="perm_write" eval="1"/>
            <field name="perm_create" eval="1"/>
            <field name="perm_unlink" eval="1"/>
        </record>

    </data>
</odoo>
