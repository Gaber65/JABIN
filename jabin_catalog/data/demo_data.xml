<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Demo Categories -->
    <record id="demo_category_meat" model="jabin.category">
        <field name="name">Meat</field>
        <field name="description">Fresh meat products</field>
        <field name="sequence">10</field>
        <field name="active">True</field>
    </record>

    <record id="demo_category_poultry" model="jabin.category">
        <field name="name">Poultry</field>
        <field name="description">Poultry products</field>
        <field name="sequence">20</field>
        <field name="active">True</field>
    </record>

    <record id="demo_category_seafood" model="jabin.category">
        <field name="name">Seafood</field>
        <field name="description">Fresh seafood products</field>
        <field name="sequence">30</field>
        <field name="active">True</field>
    </record>

    <!-- Demo Cutting Options -->
    <record id="demo_cutting_whole" model="jabin.cutting.option">
        <field name="name">Whole</field>
        <field name="description">Whole product</field>
        <field name="active">True</field>
    </record>

    <record id="demo_cutting_half" model="jabin.cutting.option">
        <field name="name">Half</field>
        <field name="description">Half cut</field>
        <field name="active">True</field>
    </record>

    <record id="demo_cutting_quarter" model="jabin.cutting.option">
        <field name="name">Quarter</field>
        <field name="description">Quarter cut</field>
        <field name="active">True</field>
    </record>

    <record id="demo_cutting_bbq" model="jabin.cutting.option">
        <field name="name">BBQ</field>
        <field name="description">BBQ style cut</field>
        <field name="active">True</field>
    </record>

    <!-- Demo Packaging -->
    <record id="demo_packaging_vacuum" model="jabin.packaging">
        <field name="name">Vacuum</field>
        <field name="description">Vacuum sealed packaging</field>
        <field name="active">True</field>
    </record>

    <record id="demo_packaging_tray" model="jabin.packaging">
        <field name="name">Tray</field>
        <field name="description">Tray packaging</field>
        <field name="active">True</field>
    </record>

    <record id="demo_packaging_box" model="jabin.packaging">
        <field name="name">Box</field>
        <field name="description">Box packaging</field>
        <field name="active">True</field>
    </record>

    <!-- Demo Excluded Parts -->
    <record id="demo_excluded_head" model="jabin.excluded.part">
        <field name="name">Head</field>
        <field name="description">Head excluded</field>
        <field name="active">True</field>
    </record>

    <record id="demo_excluded_legs" model="jabin.excluded.part">
        <field name="name">Legs</field>
        <field name="description">Legs excluded</field>
        <field name="active">True</field>
    </record>

    <record id="demo_excluded_fat" model="jabin.excluded.part">
        <field name="name">Fat</field>
        <field name="description">Fat excluded</field>
        <field name="active">True</field>
    </record>
</odoo>