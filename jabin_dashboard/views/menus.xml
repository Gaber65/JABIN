<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Main JABIN Menu -->
        <menuitem id="menu_jabin_root"
                  name="JABIN"
                  sequence="10"
                  web_icon="jabin_dashboard,static/description/icon.png"/>

        <!-- Dashboard Menu -->
        <menuitem id="menu_jabin_dashboard"
                  name="Dashboard"
                  parent="menu_jabin_root"
                  action="action_jabin_dashboard_view"
                  sequence="10"
        />






        <!-- Placeholder Actions for Menu Items -->
        <record id="action_jabin_catalog_products" model="ir.actions.act_window">
            <field name="name">Products</field>
            <field name="res_model">ir.ui.view</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p>Products module coming soon</p>
            </field>
        </record>
    </data>
</odoo>