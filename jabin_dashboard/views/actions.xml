<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Window Action for Dashboard Configuration -->
        <record id="action_jabin_dashboard" model="ir.actions.act_window">
            <field name="name">Dashboards</field>
            <field name="res_model">jabin.dashboard</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Add your first dashboard section
                </p>
                <p>
                    Dashboard sections help organize your dashboard content.
                </p>
            </field>
        </record>

        <!-- Client Action for Dashboard View -->
        <record id="action_jabin_dashboard_view" model="ir.actions.client">
            <field name="name">Dashboard</field>
            <field name="tag">jabin_dashboard.dashboard_view</field>
            <field name="target">main</field>
        </record>

        <!-- Window Action for Dashboard Settings -->
        <record id="action_jabin_dashboard_settings" model="ir.actions.act_window">
            <field name="name">Dashboard Settings</field>
            <field name="res_model">jabin.dashboard.setting</field>
            <field name="view_mode">form</field>
            <field name="target">new</field>
            <field name="view_id" ref="view_jabin_dashboard_settings"/>
        </record>

        <!-- Window Action for Products - Using custom model -->
        <record id="action_jabin_product" model="ir.actions.act_window">
            <field name="name">Products</field>
            <field name="res_model">jabin.product</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Manage your products
                </p>
            </field>
        </record>

        <!-- Window Action for Categories - Using custom model -->
        <record id="action_jabin_category" model="ir.actions.act_window">
            <field name="name">Categories</field>
            <field name="res_model">jabin.category</field>
            <field name="view_mode">tree,form</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    Manage product categories
                </p>
            </field>
        </record>

        <!-- Window Action for Cutting Options -->
        <record id="action_jabin_cutting_option" model="ir.actions.act_window">
            <field name="name">Cutting Options</field>
            <field name="res_model">jabin.cutting.option</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Window Action for Packaging Options -->
        <record id="action_jabin_packaging" model="ir.actions.act_window">
            <field name="name">Packaging Options</field>
            <field name="res_model">jabin.packaging</field>
            <field name="view_mode">tree,form</field>
        </record>

        <!-- Window Action for Excluded Parts -->
        <record id="action_jabin_excluded_part" model="ir.actions.act_window">
            <field name="name">Excluded Parts</field>
            <field name="res_model">jabin.excluded.part</field>
            <field name="view_mode">tree,form</field>
        </record>
    </data>
</odoo>